+                    raise EvidenceUnavailable("recorded HTTP response status invalid")
+                body = _verified_blob(self.root, row)
+                values = list(re.finditer(rb'(?:var\s+)?hq_str_(P_OP_mo[0-9]{4}[CP][0-9]+)="([^"\r\n]*)";?', body))
+                returned = [m[1].decode("ascii") for m in values]
+                if len(returned) != len(set(returned)) or set(returned) != set(symbols):
+                    raise EvidenceUnavailable("recorded Sina verification batch identities incomplete")
+                selected = next(m[0] for m in values if m[1].decode("ascii") == params["list"])
+                return {**row, "body": selected, "projection": "exact_recorded_Sina_variable",
+                        "parent_raw_sha256": row["sha256"]}
+        if not matches:
+            self.missing_inputs.append({"role": "http", "url": url, "params": params})
+            raise EvidenceUnavailable(f"{self.day} original evidence has no recorded HTTP request: {url}")
+        row = matches[-1]
+        if type(row.get("status_code")) is not int or not 100 <= row["status_code"] <= 599:
+            raise EvidenceUnavailable("recorded HTTP response status invalid")
+        return {**row, "body": _verified_blob(self.root, row)}
+
