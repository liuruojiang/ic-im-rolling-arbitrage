FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ICIM_STATE_DIR=/data/ic_im_v1_3 \
    PORT=8000

WORKDIR /app

COPY requirements-poe-v1.3-server.txt ./
RUN python -m pip install --no-cache-dir -r requirements-poe-v1.3-server.txt

COPY poe_ic_im_mainline_v1_3_bot.py ./
COPY poe_ic_im_v1_3_state.py ./
COPY poe_ic_im_v1_3_server.py ./

VOLUME ["/data"]
EXPOSE 8000

CMD ["sh", "-c", "test -n \"$POE_ACCESS_KEY\" || { echo 'POE_ACCESS_KEY is required' >&2; exit 64; }; exec uvicorn poe_ic_im_v1_3_server:app --host 0.0.0.0 --port \"$PORT\""]
